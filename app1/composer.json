{
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:CommishArt/idp-bundle.git"
        }
    ],
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "commish/idp-bundle": "^1.0.15",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.7",
        "knpuniversity/oauth2-client-bundle": "^2.20.2",
        "league/oauth2-client": "^2.9",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.2",
        "symfony/asset": "^8.0.8",
        "symfony/asset-mapper": "^8.0.13",
        "symfony/console": "^8.0.13",
        "symfony/doctrine-messenger": "^8.0.6",
        "symfony/dotenv": "^8.0.11",
        "symfony/expression-language": "^8.0.8",
        "symfony/flex": "^2.11",
        "symfony/form": "^8.0.9",
        "symfony/framework-bundle": "^8.0.13",
        "symfony/http-client": "^8.0.13",
        "symfony/intl": "^8.0.8",
        "symfony/mailer": "^8.0.12",
        "symfony/mime": "^8.0.13",
        "symfony/monolog-bundle": "^3.0|^4.0.2",
        "symfony/notifier": "^8.0.8",
        "symfony/process": "^8.0.13",
        "symfony/property-access": "^8.0.8",
        "symfony/property-info": "^8.0.8",
        "symfony/runtime": "^8.0.13",
        "symfony/security-bundle": "^8.0.13",
        "symfony/serializer": "^8.0.10",
        "symfony/stimulus-bundle": "^3.1",
        "symfony/string": "^8.0.13",
        "symfony/translation": "^8.0.10",
        "symfony/twig-bundle": "^8.0.8",
        "symfony/uid": "^8.0.9",
        "symfony/ux-turbo": "^3.1",
        "symfony/validator": "^8.0.10",
        "symfony/web-link": "^8.0.8",
        "symfony/yaml": "^8.0.13",
        "twig/extra-bundle": "^2.12|^3.24",
        "twig/twig": "^2.12|^3.27"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^8.0",
            "endpoint": [
                "https://api.github.com/repos/CommishArt/recipes/contents/index.json",
                "flex://defaults"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1.13",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/debug-bundle": "^8.0",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "^8.0",
        "symfony/web-profiler-bundle": "^8.0"
    }
}
